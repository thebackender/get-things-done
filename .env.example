# Copy this file to .env and change what you need. .env is not committed to git.
# Command-line options win over these values: python3 server.py 9000 --backup-dir /some/path

# Folder for the daily backups of data/planner.json. Another disk or a synced cloud folder
# keeps them safe if this disk fails. ~ means your home folder. Default: data/backups
# GTD_BACKUP_DIR=~/Dropbox/gtd-backups

# Port the server listens on. Default: 8000
# GTD_PORT=8000
